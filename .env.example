# Copy to .env and fill in. .env is gitignored; this file holds no secrets.

# ---- Database (docker-compose.yml reads the first three) ----
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fleet
DATABASE_URL=postgres://fleet:change-me@127.0.0.1:5434/fleet?sslmode=disable

PORT=8080

# ---- Sign-in ----
# The dispatch agent's service key. Must match AGENT_API_KEY in the agent's .env.
# Generate with: openssl rand -hex 32
AGENT_API_KEY=
# Session cookie over HTTPS only. Keep true; browsers allow it on http://localhost.
COOKIE_SECURE=true
# How long a sign-in lasts.
DISPATCHER_SESSION_TTL=12h
DRIVER_SESSION_TTL=336h
# Browser origins allowed to call the API directly (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3471

# ---- Operator display settings, served at GET /config ----
OPERATOR_UNITS=metric
OPERATOR_TIMEZONE=Africa/Lagos
OPERATOR_LANGUAGE=en-NG

# ---- Service area: stops and GPS outside it are refused ----
SERVICE_MIN_LAT=6.2
SERVICE_MAX_LAT=6.8
SERVICE_MIN_LNG=2.7
SERVICE_MAX_LNG=4.0

# ---- Map opening view ----
MAP_CENTER_LAT=6.5244
MAP_CENTER_LNG=3.3792
MAP_DEFAULT_ZOOM=11

# ---- Address search (Nominatim) ----
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=trucking-logistics-dispatch/0.1
# GEOCODER_EMAIL=

# ---- cmd/seed and cmd/simulator sign in as this dispatcher ----
# Create it first: go run ./cmd/adduser -email you@example.com -name "Your Name"
SEED_EMAIL=
SEED_PASSWORD=
# SEED_DRIVER_PIN=1234
